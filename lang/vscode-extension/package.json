{
    "name": "xtc-language",
    "displayName": "Ecstasy Language Support",
    "description": "Visual Studio Code support for the Ecstasy programming language (also known by its file extension and informal short-form, XTC). Source files use the .x extension. Includes syntax highlighting, LSP-based language features (hover, completion, go-to-definition), debugging via DAP, snippets, and project scaffolding.",
    "version": "0.4.4",
    "publisher": "xtclang",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/xtclang/xvm"
    },
    "engines": {
        "vscode": "^1.101.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers",
        "Snippets",
        "Formatters"
    ],
    "keywords": [
        "ecstasy",
        "ecstasy-language",
        "xtc",
        "xvm",
        "xtclang",
        "xdk"
    ],
    "icon": "icons/xtc.png",
    "galleryBanner": {
        "color": "#1f2937",
        "theme": "dark"
    },
    "activationEvents": [
        "onStartupFinished",
        "onLanguage:xtc",
        "workspaceContains:**/*.x"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "xtc",
                "aliases": [
                    "Ecstasy",
                    "XTC",
                    "xtc"
                ],
                "extensions": [
                    ".x"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/xtc-file.png",
                    "dark": "./icons/xtc-file.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "xtc",
                "scopeName": "source.xtc",
                "path": "./syntaxes/xtc.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "xtc",
                "path": "./snippets/xtc.json"
            }
        ],
        "commands": [
            {
                "command": "xtc.configureCompilerPaths",
                "title": "Ecstasy: Configure Compiler Paths"
            },
            {
                "command": "xtc.showCompilerPaths",
                "title": "Ecstasy: Show Effective Compiler Paths"
            },
            {
                "command": "xtc.refreshCompilerBuild",
                "title": "Ecstasy: Refresh Gradle Compiler Model"
            },
            {
                "command": "xtc.prepareCompilerInputs",
                "title": "Ecstasy: Prepare Generated Compiler Resources"
            },
            {
                "command": "xtc.createProject",
                "title": "Ecstasy: Create New Project"
            },
            {
                "command": "xtc.runModule",
                "title": "Ecstasy: Run Module"
            },
            {
                "command": "xtc.restartServer",
                "title": "Ecstasy: Restart Language Server"
            },
            {
                "command": "xtc.showServerOutput",
                "title": "Ecstasy: Show Language Server Output"
            },
            {
                "command": "xtc.hideServerOutput",
                "title": "Ecstasy: Hide Language Server Output"
            },
            {
                "command": "xtc.openLanguageSettings",
                "title": "Ecstasy: Open Language Service Settings"
            },
            {
                "command": "xtc.showLanguageServiceStatus",
                "title": "Ecstasy: Show Effective Language Service Configuration"
            }
        ],
        "keybindings": [
            {
                "command": "xtc.showServerOutput",
                "key": "ctrl+alt+x l"
            },
            {
                "command": "xtc.hideServerOutput",
                "key": "ctrl+alt+x l",
                "when": "view.workbench.panel.output.visible && activeOutputChannel =~ /xtclang\\.xtc-language\\.Ecstasy Language Server(?:\\.\\d+)?\\.log$/"
            }
        ],
        "taskDefinitions": [
            {
                "type": "xtc",
                "required": [
                    "moduleName"
                ],
                "properties": {
                    "moduleName": {
                        "type": "string",
                        "description": "The Ecstasy (.xtc) module to run"
                    },
                    "methodName": {
                        "type": "string",
                        "description": "Method to invoke (defaults to 'run')"
                    },
                    "moduleArguments": {
                        "type": "string",
                        "description": "Comma-separated arguments passed to the module"
                    },
                    "useGradle": {
                        "type": "boolean",
                        "default": true,
                        "description": "Use Gradle to run (recommended for projects with build.gradle.kts)"
                    },
                    "quietMode": {
                        "type": "boolean",
                        "default": true,
                        "description": "Use -q flag for less verbose Gradle output"
                    }
                }
            }
        ],
        "configuration": {
            "title": "Ecstasy",
            "properties": {
                "xtc.java.home": {
                    "type": "string",
                    "default": "",
                    "description": "Path to Java 25+ installation (overrides JAVA_HOME). Leave empty to use JAVA_HOME or 'java' in PATH.",
                    "scope": "machine-overridable"
                },
                "xtc.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace communication between VS Code and the Ecstasy Language Server (for debugging)",
                    "scope": "window"
                },
                "xtc.inlayHints.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show Ecstasy inlay hints. Applies immediately; the native editor.inlayHints.enabled preference also applies.",
                    "scope": "resource"
                },
                "xtc.formatting.indentSize": {
                    "type": "integer",
                    "default": 4,
                    "description": "Number of spaces per indentation level",
                    "scope": "window",
                    "minimum": 1,
                    "maximum": 32
                },
                "xtc.formatting.continuationIndentSize": {
                    "type": "integer",
                    "default": 8,
                    "description": "Number of spaces for continuation lines",
                    "scope": "window",
                    "minimum": 1,
                    "maximum": 32
                },
                "xtc.formatting.tabSize": {
                    "type": "integer",
                    "default": 4,
                    "description": "Tab width in spaces",
                    "scope": "window",
                    "minimum": 1,
                    "maximum": 32,
                    "deprecationMessage": "This legacy value does not affect the formatter. Use editor.tabSize for visual tab width."
                },
                "xtc.formatting.insertSpaces": {
                    "type": "boolean",
                    "default": true,
                    "description": "Use spaces instead of tabs",
                    "scope": "window"
                },
                "xtc.formatting.maxLineWidth": {
                    "type": "integer",
                    "default": 120,
                    "description": "Compiler adapter target width for expression and list wrapping at safe token boundaries; literals and comments are not split.",
                    "scope": "window",
                    "minimum": 1,
                    "maximum": 1000
                },
                "xtc.compiler.sourceModules": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "default": null,
                    "scope": "window",
                    "description": "Compiler source graph: null discovers workspace modules; [] disables discovery; an array supplies explicit roots and edges. Changes apply without restarting. Relative URIs require a single workspace folder.",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "uri"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Declared Ecstasy module name."
                            },
                            "uri": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Module .x root: a file URI or URI relative to the workspace folder."
                            },
                            "dependencies": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "uniqueItems": true,
                                "default": [],
                                "description": "Names of source modules this module imports."
                            },
                            "resourceRoots": {
                                "type": [
                                    "array",
                                    "null"
                                ],
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "uniqueItems": true,
                                "default": null,
                                "description": "Ordered resource root file URIs or workspace-relative paths. Omitted/null uses compiler layout deduction; [] disables resources. Explicit roots replace the defaults. Gradle model imports use evaluated processed resources unless an explicit graph overrides them."
                            }
                        }
                    }
                },
                "xtc.sourceRoots": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Extra source root directories the Ecstasy Language Server indexes (e.g. XDK standard-library sources). Accepts absolute paths to directories that contain .x source files outside the open workspace.",
                    "scope": "machine-overridable"
                },
                "xtc.languageService.textSynchronization": {
                    "type": "string",
                    "enum": [
                        "full",
                        "incremental"
                    ],
                    "enumDescriptions": [
                        "Send the full document after changes (default).",
                        "Send changed text ranges. This does not enable incremental compilation."
                    ],
                    "default": "full",
                    "scope": "window",
                    "description": "Text transport to the language server. Apply through Ecstasy: Restart Language Server; all open buffers are resynchronized."
                },
                "xtc.languageService.saveFormatting": {
                    "type": "string",
                    "enum": [
                        "editor",
                        "server"
                    ],
                    "enumDescriptions": [
                        "Use the native editor.formatOnSave preference.",
                        "Request server save edits when native format-on-save is disabled."
                    ],
                    "default": "editor",
                    "scope": "window",
                    "description": "Owner of save formatting. Native format-on-save takes precedence to prevent duplicate edits. Changing this requires a language server restart."
                }
            }
        },
        "configurationDefaults": {
            "files.associations": {
                "*.x": "xtc"
            },
            "[xtc]": {
                "editor.tabSize": 4,
                "editor.insertSpaces": true,
                "editor.formatOnType": true,
                "editor.autoIndent": "full",
                "editor.semanticHighlighting.enabled": true,
                "editor.bracketPairColorization.enabled": true,
                "editor.guides.bracketPairs": "active",
                "editor.suggest.snippetsPreventQuickSuggestions": false,
                "editor.wordBasedSuggestions": "off"
            }
        },
        "debuggers": [
            {
                "type": "xtc",
                "label": "Ecstasy Debug",
                "languages": [
                    "xtc"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "module"
                        ],
                        "properties": {
                            "module": {
                                "type": "string",
                                "description": "The Ecstasy (.xtc) module to debug"
                            },
                            "method": {
                                "type": "string",
                                "description": "Method to invoke (defaults to 'run')",
                                "default": "run"
                            },
                            "args": {
                                "type": "string",
                                "description": "Comma-separated arguments passed to the module"
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Working directory",
                                "default": "${workspaceFolder}"
                            }
                        }
                    }
                },
                "configurationSnippets": [
                    {
                        "label": "Ecstasy: Launch Module",
                        "description": "Launch and debug an Ecstasy module",
                        "body": {
                            "type": "xtc",
                            "request": "launch",
                            "name": "Debug ${1:module}",
                            "module": "${1:myapp}"
                        }
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run generate:icons && npm run bundle",
        "generate:icons": "node scripts/generate-icons.cjs ../../doc/logo/x.jpg icons",
        "bundle": "node scripts/bundle.cjs out/extension.js",
        "compile": "tsc -p ./",
        "watch": "node scripts/bundle.cjs out/extension.js --watch",
        "package": "vsce package",
        "lint": "eslint src/",
        "test:vscode": "node ./scripts/run-vscode-tests.cjs",
        "test:playbook": "node ./scripts/run-vscode-tests.cjs --playbook"
    },
    "dependencies": {
        "jdk-utils": "^0.7.0",
        "jsonc-parser": "^3.3.1",
        "vscode-languageclient": "^10.1.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "~22.15.35",
        "@types/vscode": "1.101.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "glob": "^13.0.6",
        "mocha": "^12.0.2",
        "playwright-core": "^1.63.0",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0"
    },
    "overrides": {
        "diff": "^8.0.3",
        "js-yaml": "^4.3.2",
        "serialize-javascript": "^7.0.5"
    },
    "allowScripts": {
        "esbuild": true,
        "@vscode/vsce-sign": true
    }
}
