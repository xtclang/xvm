<idea-plugin>
    <id>org.xtclang.idea</id>
    <name>Ecstasy Language Support</name>
    <vendor email="info@xtclang.org" url="https://xtclang.org">Ecstasy Language</vendor>

    <description><![CDATA[
        IntelliJ IDEA support for the Ecstasy programming language (also known
        by its file extension and informal short-form, XTC). Source files use
        the <code>.x</code> extension.

        Features:
        <ul>
            <li>New Project wizard for Ecstasy (XTC) projects</li>
            <li>Run configurations for Ecstasy (XTC) applications</li>
            <li>Syntax highlighting for .x files</li>
            <li>Language features via LSP (hover, completion, go-to-definition)</li>
        </ul>

        Requirements:
        <ul>
            <li>XDK installed with XDK_HOME environment variable set, OR</li>
            <li>The LSP server JAR bundled with the plugin</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.gradle</depends>
    <!-- TextMate plugin for syntax highlighting -->
    <depends>org.jetbrains.plugins.textmate</depends>
    <!-- LSP4IJ provides LSP support for Community Edition -->
    <depends>com.redhat.devtools.lsp4ij</depends>

    <actions>
        <action id="xtc.resolveCodeAction" class="org.xtclang.idea.lsp.XtcResolveCodeAction"/>
        <action id="xtc.toggleServerLog" class="org.xtclang.idea.lsp.XtcServerLogAction"
                text="Toggle Ecstasy Language Server Log"
                description="Show the Ecstasy server log or hide the Language Servers tool window">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt X" second-keystroke="L"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl alt X" second-keystroke="L"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="org.xtclang.idea.lsp.CompilerBuildUpdates"/>
        <externalSystemTaskNotificationListener implementation="org.xtclang.idea.lsp.CompilerGradleSync"/>
        <applicationConfigurable id="xtc.service.defaults" parentId="language"
                                 displayName="Ecstasy Language Service Defaults"
                                 instance="org.xtclang.idea.lsp.LanguageServiceApplicationConfigurable"/>
        <applicationConfigurable id="xtc.runtime" parentId="language" displayName="Ecstasy Server Runtime"
                                 instance="org.xtclang.idea.lsp.ServerRuntimeConfigurable"/>
        <projectConfigurable id="xtc.service" parentId="language"
                             displayName="Ecstasy Language Service"
                             instance="org.xtclang.idea.lsp.LanguageServiceProjectConfigurable"/>
        <projectConfigurable id="xtc.compiler" parentId="language" displayName="Ecstasy Compiler"
                             instance="org.xtclang.idea.lsp.CompilerProjectConfigurable"/>
        <!-- Notification group for LSP status messages -->
        <notificationGroup id="XTC Language Server"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <!-- Claim *.x as an Ecstasy source file so IntelliJ does not suggest unrelated Marketplace plugins. -->
        <fileType name="Ecstasy"
                  implementationClass="org.xtclang.idea.XtcFileType"
                  fieldName="INSTANCE"
                  language="Ecstasy"
                  extensions="x"/>

        <!-- Project Generator for New Project wizard (IntelliJ IDEA) -->
        <newProjectWizard.generator
            implementation="org.xtclang.idea.project.XtcNewProjectWizard"/>

        <!-- Run Configuration -->
        <configurationType
            implementation="org.xtclang.idea.run.XtcRunConfigurationType"/>

        <!-- Run Configuration Producer - auto-creates run configs from .x file context -->
        <runConfigurationProducer
            implementation="org.xtclang.idea.run.XtcRunConfigurationProducer"/>

        <!-- IconProvider for .x PSI files in contexts that do not ask the file type directly. -->
        <iconProvider implementation="org.xtclang.idea.XtcIconProvider"/>

        <!-- Live templates: code snippets triggered by abbreviation + Tab (e.g. cls, fori, sout) -->
        <defaultLiveTemplates>/liveTemplates/XTC</defaultLiveTemplates>

        <!-- Commenter for Ctrl+/ (line comment) and Ctrl+Shift+/ (block comment) -->
        <lang.commenter language="Ecstasy"
                        implementationClass="org.xtclang.idea.XtcCommenter"/>

        <!-- Check the request's document snapshot before applying a compiler rename. -->
        <renameHandler implementation="org.xtclang.idea.lsp.XtcRenameHandler"/>
        <renameHandler implementation="org.xtclang.idea.lsp.XtcFileRenameHandler"/>
        <refactoring.moveHandler implementation="org.xtclang.idea.lsp.XtcFileMoveHandler" order="first"/>

        <!-- Preserve candidate signatures when the compiler cannot select an active argument. -->
        <codeInsight.parameterInfo language="Ecstasy"
                                   implementationClass="org.xtclang.idea.lsp.XtcParameterInfoHandler"/>
        <codeInsight.parameterInfo language="TEXT"
                                   order="before LSPParameterInfoHandlerForTEXT"
                                   implementationClass="org.xtclang.idea.lsp.XtcParameterInfoHandler"/>
        <codeInsight.parameterInfo language="textmate"
                                   order="before LSPParameterInfoHandlerForTextMate"
                                   implementationClass="org.xtclang.idea.lsp.XtcParameterInfoHandler"/>

        <!-- Code Style settings for XTC (Settings > Editor > Code Style > Ecstasy) -->
        <formattingService id="XtcFormattingService"
                           order="before LSPFormattingOnlyService, before LSPFormattingAndRangeBothService"
                           implementation="org.xtclang.idea.lsp.XtcFormattingService"/>
        <langCodeStyleSettingsProvider
            implementation="org.xtclang.idea.style.XtcLanguageCodeStyleSettingsProvider"/>

        <!-- Repair local IntelliJ Enter handling for .x empty-block splits using IDE code style -->
        <enterHandlerDelegate implementation="org.xtclang.idea.editor.XtcEnterHandlerDelegate"/>

        <!-- Probe active editor delegates in the sandbox so we can verify registration -->
        <postStartupActivity implementation="org.xtclang.idea.editor.XtcEditorStartupActivity"/>

        <!-- TODO: Re-enable DAP registration when the feature is implemented and stable enough
             to ship without Plugin Verifier experimental API findings.
        <debugAdapterServer id="xtcDebugAdapter"
                            name="Ecstasy Debug Adapter"
                            factoryClass="org.xtclang.idea.dap.XtcDebugAdapterFactory"/>
        -->
    </extensions>

    <!-- LSP4IJ Language Server registration -->
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="xtcLanguageServer"
                name="Ecstasy Language Server"
                factoryClass="org.xtclang.idea.lsp.XtcLanguageServerFactory">
            <description><![CDATA[
                Provides language features for Ecstasy files via LSP.
                Requires XDK_HOME to be set or the LSP server JAR to be bundled.
            ]]></description>
        </server>
        <fileNamePatternMapping patterns="*.x"
                                 serverId="xtcLanguageServer"/>

    </extensions>

    <!-- TextMate grammar for syntax highlighting (via IntelliJ's TextMate plugin) -->
    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider
            implementation="org.xtclang.idea.XtcTextMateBundleProvider"/>
    </extensions>
</idea-plugin>
