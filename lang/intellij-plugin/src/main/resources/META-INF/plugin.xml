<idea-plugin>
    <id>org.xtclang.idea</id>
    <name>Ecstasy Language Support</name>
    <vendor email="info@xtclang.org" url="https://xtclang.org">Ecstasy Language</vendor>

    <description><![CDATA[
        IntelliJ IDEA support for the Ecstasy programming language (also known
        by its file extension and informal short-form, XTC). Source files use
        the <code>.x</code> extension.

        Features:
        <ul>
            <li>New Project wizard for Ecstasy (XTC) projects</li>
            <li>Run configurations for Ecstasy (XTC) applications</li>
            <li>Syntax highlighting for .x files</li>
            <li>Language features via LSP (hover, completion, go-to-definition)</li>
        </ul>

        Requirements:
        <ul>
            <li>XDK installed with XDK_HOME environment variable set, OR</li>
            <li>The LSP server JAR bundled with the plugin</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- TextMate plugin for syntax highlighting -->
    <depends>org.jetbrains.plugins.textmate</depends>
    <!-- LSP4IJ provides LSP support for Community Edition -->
    <depends>com.redhat.devtools.lsp4ij</depends>
    <!-- IntelliJ's test console, which shows xunit's tests -->
    <depends>intellij.testRunner.plugin</depends>
    <!-- IntelliJ's Problems view, whose Project Errors ProjectErrors fills: part of the platform up to 2026.2, and from
         2026.3 a bundled plugin of its own, whose classes a plugin sees only by depending on it -->
    <depends optional="true" config-file="xtc-problems-view.xml">com.intellij.problemsView</depends>

    <actions>
        <action id="xtc.selectLanguageAdapter" class="org.xtclang.idea.lsp.SelectLanguageAdapterAction"
                text="Switch Ecstasy Language Adapter"
                description="Choose Compiler or Tree-sitter and restart the language server with open buffers preserved">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt X" second-keystroke="A"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl alt X" second-keystroke="A"/>
            <!-- The default macOS keymap would otherwise derive Command from $default's ctrl. -->
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl alt X" second-keystroke="A"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="xtc.showReferences" class="com.redhat.devtools.lsp4ij.commands.editor.ShowReferencesAction"/>
        <action id="xtc.exportServerLogs" class="org.xtclang.idea.lsp.ExportServerLogsAction"
                text="Export Ecstasy Server Logs" description="Save recent server logs, timing traces and status as a ZIP">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <!-- The Run lens's LSP command: builds and runs the module the way the project builds and runs. -->
        <action id="xtc.runModule" class="org.xtclang.idea.run.XtcRunModuleAction"
                text="Run Ecstasy Module" description="Build and run the Ecstasy module in this editor"
                icon="AllIcons.Actions.Execute"/>
        <!-- Run All Ecstasy Tests on a folder whose tests are Java or Kotlin ones too, where Gradle's "Tests in" replaces it -->
        <action id="xtc.runAllTests" class="org.xtclang.idea.run.XtcRunAllTestsAction"
                text="Run All Ecstasy Tests" description="Run every Ecstasy test module's tests, each module in turn"
                icon="AllIcons.Actions.Execute">
            <add-to-group group-id="ProjectViewPopupMenuRunGroup" anchor="last"/>
        </action>
        <action id="xtc.selectBuildMode" class="org.xtclang.idea.run.SelectBuildModeAction"
                text="Select Ecstasy Build Mode"
                description="Choose whether Ecstasy Build, Rebuild and Run use the embedded compiler or Gradle">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt X" second-keystroke="B"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl alt X" second-keystroke="B"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl alt X" second-keystroke="B"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="xtc.restartLanguageServer" class="org.xtclang.idea.lsp.RestartLanguageServerAction"
                text="Restart Ecstasy Language Server"
                description="Restart the Ecstasy language server with its adapter and the saved runtime settings">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt X" second-keystroke="R"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl alt X" second-keystroke="R"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl alt X" second-keystroke="R"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="xtc.toggleServerLog" class="org.xtclang.idea.lsp.XtcServerLogAction"
                text="Toggle Ecstasy Language Server Log"
                description="Show the Ecstasy server log or hide the Language Servers tool window">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt X" second-keystroke="L"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="ctrl alt X" second-keystroke="L"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="ctrl alt X" second-keystroke="L"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="org.xtclang.idea.lsp.ServerControlStartup"/>
        <postStartupActivity implementation="org.xtclang.idea.lsp.CompilerBuildUpdates"/>
        <externalSystemTaskNotificationListener implementation="org.xtclang.idea.lsp.CompilerGradleSync"/>
        <!-- Languages & Frameworks | Ecstasy: one node for every settings page of the plugin, project and application -->
        <applicationConfigurable id="xtc" parentId="language" displayName="Ecstasy"
                                 instance="org.xtclang.idea.lsp.EcstasyConfigurable"/>
        <projectConfigurable id="xtc.service" parentId="xtc" displayName="Language Service"
                             instance="org.xtclang.idea.lsp.LanguageServiceProjectConfigurable"/>
        <applicationConfigurable id="xtc.service.defaults" parentId="xtc" displayName="Language Service Defaults"
                                 instance="org.xtclang.idea.lsp.LanguageServiceApplicationConfigurable"/>
        <projectConfigurable id="xtc.compiler" parentId="xtc" displayName="Compiler"
                             instance="org.xtclang.idea.lsp.CompilerProjectConfigurable"/>
        <applicationConfigurable id="xtc.runtime" parentId="xtc" displayName="Server Runtime and Logs"
                                 instance="org.xtclang.idea.lsp.ServerRuntimeConfigurable"/>
        <!-- build and run with the embedded compiler or Gradle; a pointer to it stays beside the IDE's build tools -->
        <projectConfigurable id="xtc.build" parentId="xtc" displayName="Build and Run"
                             instance="org.xtclang.idea.run.XtcBuildConfigurable"/>
        <projectConfigurable id="xtc.build.pointer" parentId="build" displayName="Ecstasy"
                             instance="org.xtclang.idea.run.XtcBuildPointerConfigurable"/>
        <!-- Build and Rebuild Project in embedded mode; ahead of the IDE's own builder for Ecstasy modules, and of
             Gradle's, which is first as well and takes every module of a Gradle project that IntelliJ imported -->
        <projectTaskRunner implementation="org.xtclang.idea.run.XtcProjectTaskRunner" order="first, before gradle"/>
        <!-- Notification group for LSP status messages -->
        <notificationGroup id="Ecstasy Language Server"
                           displayType="BALLOON"
                           isLogByDefault="true"/>

        <!-- Tip of the Day, which IntelliJ paces and the user can turn off. Each tip belongs to a feature in
             XtcProductivityFeatures.xml, whose tracked actions count its uses, so tips about what the user already
             does come last. The features also appear in Help | My Productivity, with the names in
             messages/XtcProductivityFeatures.properties. -->
        <tipAndTrick file="XtcServerLog.html"/>
        <tipAndTrick file="XtcRestartServer.html"/>
        <tipAndTrick file="XtcLanguageAdapter.html"/>
        <tipAndTrick file="XtcBuildMode.html"/>
        <tipAndTrick file="XtcExportServerLogs.html"/>
        <tipAndTrick file="XtcRunAndTest.html"/>
        <productivityFeaturesProvider implementation="org.xtclang.idea.XtcProductivityFeatures"/>
        <featureStatisticsBundle qualifiedName="messages.XtcProductivityFeatures"/>

        <!-- Claim *.x as an Ecstasy source file so IntelliJ does not suggest unrelated Marketplace plugins. -->
        <fileType name="Ecstasy"
                  implementationClass="org.xtclang.idea.XtcFileType"
                  fieldName="INSTANCE"
                  language="Ecstasy"
                  extensions="x"/>
        <!-- Owning the file type bypasses TextMate's file-type registration. Reuse both its
             grammar-backed lexer and its scope-aware editor token storage for Ecstasy. -->
        <lang.syntaxHighlighterFactory language="Ecstasy"
            implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>
        <editorHighlighterProvider filetype="Ecstasy"
            implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
        <!-- A flat PSI of the Ecstasy language, so that what IntelliJ looks up by a file's language applies. -->
        <lang.parserDefinition language="Ecstasy" implementationClass="org.xtclang.idea.XtcParserDefinition"/>
        <!-- LSP4IJ registers these for TEXT and TextMate PSI only, which an Ecstasy file's PSI is not. -->
        <lang.psiStructureViewFactory language="Ecstasy"
            implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>
        <lang.foldingBuilder language="Ecstasy" order="first"
            implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"/>
        <codeBlockProvider language="Ecstasy" order="first"
            implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"/>
        <typeHierarchyProvider language="Ecstasy"
            implementationClass="com.redhat.devtools.lsp4ij.features.typeHierarchy.LSPTypeHierarchyProvider"/>
        <!-- TODO LSP4IJ: UP88 — LSP4IJ's, whose callers IntelliJ computes again after a write action interrupts them -->
        <callHierarchyProvider language="Ecstasy"
            implementationClass="org.xtclang.idea.lsp.XtcCallHierarchyProvider"/>

        <!-- Project Generator for New Project wizard (IntelliJ IDEA) -->
        <newProjectWizard.generator
            implementation="org.xtclang.idea.project.XtcNewProjectWizard"/>

        <!-- Run Configuration -->
        <configurationType
            implementation="org.xtclang.idea.run.XtcRunConfigurationType"/>
        <!-- Ecstasy Attach: Debug attaches to a program that the launcher runs under its debug option -->
        <configurationType
            implementation="org.xtclang.idea.run.XtcAttachConfigurationType"/>

        <!-- Run Configuration Producer - auto-creates run configs from .x file context -->
        <runConfigurationProducer
            implementation="org.xtclang.idea.run.XtcRunConfigurationProducer"/>
        <!-- Run All Ecstasy Tests: on the project's folder or its test sources, every test module's tests in one run -->
        <runConfigurationProducer
            implementation="org.xtclang.idea.run.XtcAllTestsConfigurationProducer"/>

        <!-- IconProvider for .x PSI files in contexts that do not ask the file type directly. -->
        <iconProvider implementation="org.xtclang.idea.XtcIconProvider"/>
        <editorTabTitleProvider implementation="org.xtclang.idea.XtcEditorTabTitleProvider"/>

        <!-- Live templates: code snippets triggered by abbreviation + Tab (e.g. cls, fori, sout) -->
        <defaultLiveTemplates file="/liveTemplates/Ecstasy.xml"/>
        <liveTemplateContext contextId="ECSTASY" implementation="org.xtclang.idea.XtcTemplateContextType"/>

        <!-- Commenter for Ctrl+/ (line comment) and Ctrl+Shift+/ (block comment) -->
        <lang.commenter language="Ecstasy"
                        implementationClass="org.xtclang.idea.XtcCommenter"/>
        <!-- An explicit completion that the language server answers with nothing offers the file's words, as in plain text -->
        <codeInsight.wordCompletionFilter language="Ecstasy" implementationClass="org.xtclang.idea.XtcWordCompletionFilter"/>
        <!-- Code | Optimize Imports (Ctrl+Alt+O) runs the language server's Organize imports. -->
        <lang.importOptimizer language="Ecstasy" implementationClass="org.xtclang.idea.lsp.XtcImportOptimizer"/>

        <!-- Check the request's document snapshot before applying a compiler rename. -->
        <renameHandler implementation="org.xtclang.idea.lsp.XtcRenameHandler"/>
        <renameHandler implementation="org.xtclang.idea.lsp.XtcFileRenameHandler"/>
        <refactoring.moveHandler implementation="org.xtclang.idea.lsp.XtcFileMoveHandler" order="first"/>

        <!-- LSP4IJ registers its signature help for TEXT and TextMate files; Ecstasy's own PSI needs it too. -->
        <codeInsight.parameterInfo language="Ecstasy"
                                   implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>

        <!-- Code Style settings for XTC (Settings > Editor > Code Style > Ecstasy) -->
        <formattingService id="XtcFormattingService"
                           order="before LSPFormattingOnlyService, before LSPFormattingAndRangeBothService"
                           implementation="org.xtclang.idea.lsp.XtcFormattingService"/>
        <langCodeStyleSettingsProvider
            implementation="org.xtclang.idea.style.XtcLanguageCodeStyleSettingsProvider"/>

        <!-- Brackets typed in an Ecstasy file stay as typed, unpaired, as in plain text -->
        <braceMatcher filetype="Ecstasy" implementationClass="org.xtclang.idea.editor.XtcBraceMatcher"/>
        <!-- Repair local IntelliJ Enter handling for .x block splits using IDE code style -->
        <enterHandlerDelegate implementation="org.xtclang.idea.editor.XtcEnterHandlerDelegate"/>
        <!-- Close the block that Enter opens after an unmatched { -->
        <enterHandlerDelegate id="xtcAfterUnmatchedBrace" order="before afterUnmatchedBrace"
                              implementation="org.xtclang.idea.editor.XtcEnterAfterUnmatchedBraceHandler"/>

        <!-- Probe active editor delegates in the sandbox so we can verify registration -->
        <postStartupActivity implementation="org.xtclang.idea.editor.XtcEditorStartupActivity"/>

        <!-- Quick Documentation of a hover that takes LSP4IJ 0.30.1 longer than 500 ms (UP82): after LSP4IJ's -->
        <platform.backend.documentation.targetProvider id="xtcLateHoverDocumentation"
                                                       implementation="org.xtclang.idea.lsp.LateHoverDocumentation"
                                                       order="after LSPDocumentationTargetProvider"/>

    </extensions>

    <!-- LSP4IJ Language Server registration -->
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="xtcLanguageServer"
                name="Ecstasy Language Server"
                factoryClass="org.xtclang.idea.lsp.XtcLanguageServerFactory">
            <description><![CDATA[
                Provides language features for Ecstasy files via LSP.
                Requires XDK_HOME to be set or the LSP server JAR to be bundled.
            ]]></description>
        </server>
        <fileNamePatternMapping patterns="*.x"
                                 serverId="xtcLanguageServer"/>

        <!-- Debug of an Ecstasy Application configuration, through a debug session in the language server.
             LSP4IJ's DAP API is experimental, which Plugin Verifier reports. -->
        <debugAdapterServer id="xtcDebugAdapter"
                            name="Ecstasy Debug Adapter"
                            factoryClass="org.xtclang.idea.dap.XtcDebugAdapterFactory"/>
    </extensions>

    <!-- TextMate grammar for syntax highlighting (via IntelliJ's TextMate plugin) -->
    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider
            implementation="org.xtclang.idea.XtcTextMateBundleProvider"/>
    </extensions>
</idea-plugin>
