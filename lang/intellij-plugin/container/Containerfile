# Linux image for running the XVM IntelliJ compiler playbook on a virtual display (Xvfb).
# Gradle provisions the JDK 25 toolchain itself (foojay); the JDK here only runs the wrapper.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Europe/Stockholm

RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-21-jdk-headless \
        ca-certificates curl unzip zip xz-utils git rsync procps psmisc file less \
        xvfb xauth x11-utils x11-xserver-utils xdotool openbox imagemagick \
        libxext6 libxrender1 libxtst6 libxi6 libxrandr2 libxinerama1 libxcursor1 libxdamage1 libxcomposite1 \
        libxkbcommon0 libxkbcommon-x11-0 libx11-xcb1 libxcb1 libgl1 libegl1 \
        libfreetype6 fontconfig fonts-dejavu-core fonts-dejavu-extra fonts-liberation fonts-noto-color-emoji \
        libglib2.0-0 libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libgbm1 libasound2t64 \
        libpango-1.0-0 libcairo2 libgtk-3-0 libdbus-1-3 dbus-x11 \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV GRADLE_USER_HOME=/gradle
WORKDIR /work
